# ─────────────────────────────────────────────────────────────
# Admina — environment variables
# Copy to `.env.local` for local dev, and add the same keys in your
# Vercel project: Settings → Environment Variables (Production).
# ─────────────────────────────────────────────────────────────

# REQUIRED — Auth.js (NextAuth v5) session encryption secret.
# Without this, deployment throws "There is a problem with the server configuration".
# Generate one with:  npx auth secret   (or)   openssl rand -base64 32
AUTH_SECRET=

# OPTIONAL — Public URL of your site, used for Open Graph/Twitter previews,
# robots.txt and sitemap.xml (e.g. https://admin.example.com).
# If blank: Vercel deployments use their own URL automatically, and local
# development uses http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# OPTIONAL — Google social login. Leave blank to hide the Google button / skip it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OPTIONAL — GitHub social login. Leave blank to skip it.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
